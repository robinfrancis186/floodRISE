FLOODRISE_ENV=demo
FLOODRISE_DATABASE_URL=sqlite+aiosqlite:///./floodrise.db
FLOODRISE_REDIS_URL=redis://localhost:6379/0
FLOODRISE_ALLOWED_ORIGINS=http://localhost:4173,http://localhost:4174,http://localhost:5173,http://localhost:5174
FLOODRISE_DEMO_MODE=true
VITE_API_URL=http://127.0.0.1:8787

# Staging/production authentication (replace values; never enable demo mode):
# FLOODRISE_ENV=production
# FLOODRISE_DEMO_MODE=false
# FLOODRISE_OIDC_ISSUER=https://cognito-idp.ap-south-1.amazonaws.com/ap-south-1_POOL_ID
# FLOODRISE_OIDC_AUDIENCE=COGNITO_APP_CLIENT_ID
# FLOODRISE_OIDC_JWKS_URL=https://cognito-idp.ap-south-1.amazonaws.com/ap-south-1_POOL_ID/.well-known/jwks.json
# FLOODRISE_SESSION_SECRET=LOAD_FROM_SECRETS_MANAGER
# FLOODRISE_OIDC_ROLE_CLAIMS=cognito:groups,roles,custom:roles
# FLOODRISE_OIDC_STEP_UP_MAX_AGE_SECONDS=300
# Static FLOODRISE_OIDC_JWKS_JSON is intended for isolated tests only.

# Firebase Hosting + Google Cloud production alternative:
# - Keep demo and live deployments in different Google Cloud projects.
# - Firebase web configuration is public project metadata. Use only the
#   dedicated floodRISE project for the selected environment; credentials,
#   bearer/refresh tokens, and service-account keys must never be written here.
# - Identity Platform or an authority OIDC provider supplies the staff bearer
#   token. Hosting-proxied cookies, if used, must be named __session.
# - Vite values are build inputs. Build Field and Operations separately if
#   their registered Firebase web apps use different app IDs. Record each
#   app's exact API key, App Check site key, and OIDC provider ID in the ignored
#   .firebase-targets.json; build receipts bind canonical digests of all three.
# VITE_DEPLOYMENT_ENVIRONMENT=live
# VITE_DEMO_MODE=false
# VITE_API_BASE_URL=/api/v1
# VITE_API_ROOT=/api/v1
# VITE_FIREBASE_API_KEY=PUBLIC_FIREBASE_WEB_API_KEY
# VITE_FIREBASE_AUTH_DOMAIN=FIREBASE_PROJECT_ID.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=FIREBASE_PROJECT_ID
# VITE_FIREBASE_APP_ID=1:GOOGLE_CLOUD_PROJECT_NUMBER:web:FIREBASE_WEB_APP_HASH
# VITE_FIREBASE_MESSAGING_SENDER_ID=GOOGLE_CLOUD_PROJECT_NUMBER
# VITE_FIREBASE_APP_CHECK_SITE_KEY=RECAPTCHA_ENTERPRISE_SITE_KEY
# VITE_FIREBASE_AUTH_PROVIDER_ID=oidc.AUTHORITY_PROVIDER_ID
# VITE_FIREBASE_AUTH_SCOPES=email,profile
# FLOODRISE_OIDC_ISSUER=https://securetoken.google.com/FIREBASE_PROJECT_ID
# FLOODRISE_OIDC_AUDIENCE=FIREBASE_PROJECT_ID
# FLOODRISE_OIDC_JWKS_URL=https://www.googleapis.com/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com
# FLOODRISE_FIREBASE_APP_CHECK_ENABLED=true
# FLOODRISE_FIREBASE_APP_CHECK_PROJECT_NUMBER=GOOGLE_CLOUD_PROJECT_NUMBER
# FLOODRISE_FIREBASE_APP_CHECK_APP_IDS=FIREBASE_WEB_APP_ID
# FLOODRISE_FIREBASE_APP_CHECK_JWKS_URL=https://firebaseappcheck.googleapis.com/v1/jwks
