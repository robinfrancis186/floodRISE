environment                    = "demo"
aws_region                     = "ap-south-1"
backup_region                  = "ap-south-2"
enable_nat_gateway             = false
api_image                      = "000000000000.dkr.ecr.ap-south-1.amazonaws.com/floodrise-api@sha256:REPLACE"
worker_image                   = "000000000000.dkr.ecr.ap-south-1.amazonaws.com/floodrise-worker@sha256:REPLACE"
tile_image                     = "000000000000.dkr.ecr.ap-south-1.amazonaws.com/floodrise-tile-api@sha256:REPLACE"
api_origin_certificate_arn     = null
cognito_domain_prefix          = "REPLACE-floodrise-demo"
oauth_callback_urls            = ["https://demo.example.invalid/auth/callback"]
oauth_logout_urls              = ["https://demo.example.invalid/"]
multi_az                       = false
deletion_protection            = false
backup_retention_days          = 7
cross_region_backup_enabled    = false
notification_driver            = "demo_log"
external_notifications_enabled = false
runtime_config_ready            = false
target_rpo_minutes             = 5
target_rto_minutes             = 30
