environment                    = "production"
aws_region                     = "ap-south-1"
backup_region                  = "ap-south-2"
enable_nat_gateway             = true
api_image                      = "000000000000.dkr.ecr.ap-south-1.amazonaws.com/floodrise-api@sha256:REPLACE"
worker_image                   = "000000000000.dkr.ecr.ap-south-1.amazonaws.com/floodrise-worker@sha256:REPLACE"
tile_image                     = "000000000000.dkr.ecr.ap-south-1.amazonaws.com/floodrise-tile-api@sha256:REPLACE"
api_origin_certificate_arn     = "arn:aws:acm:ap-south-1:000000000000:certificate/REPLACE"
cognito_domain_prefix          = "REPLACE-floodrise-production"
oauth_callback_urls            = ["https://app.example.invalid/auth/callback"]
oauth_logout_urls              = ["https://app.example.invalid/"]
multi_az                       = true
deletion_protection            = true
backup_retention_days          = 35
cross_region_backup_enabled    = true
notification_driver            = "REPLACE_REVIEWED_PROVIDER"
external_notifications_enabled = false
runtime_config_ready            = false
target_rpo_minutes             = 5
target_rto_minutes             = 30
