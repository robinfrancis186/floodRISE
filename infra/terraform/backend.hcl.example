# Pass this file to `terraform init -backend-config=...` after creating a
# dedicated, encrypted state bucket and lock table through the organization
# bootstrap process. Never share state between demo and production.
bucket         = "REPLACE-floodrise-terraform-state"
key            = "demo/ap-south-1/platform.tfstate"
region         = "ap-south-1"
encrypt        = true
dynamodb_table = "REPLACE-floodrise-terraform-locks"
